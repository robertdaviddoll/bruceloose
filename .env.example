# Bruce Loose settings.
# Copy this file to .env and change what you need:   cp .env.example .env
# docker compose and `npm run dev` both read .env automatically.
# .env is git-ignored; this example file is the one that gets committed.

# Port to play on: http://localhost:GAME_PORT
GAME_PORT=8080

# How many scores one IP address can save per minute
SAVES_PER_MINUTE=6
